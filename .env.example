# Copy to .env and fill in. Never commit .env. Credentials come from your AWS profile, not from here.
AWS_REGION=us-east-2

# LLM for parse + explain (Bedrock inference profile).
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Embeddings for the dish catalog and for queries. Changing this means re-running `npm run ingest`.
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# From the `dining-vector-db` CloudFormation stack outputs (infra/vector-db.yaml).
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=dining

# Local path to the catalog CSV used by `npm run ingest`.
CATALOG_CSV=data/gsu_dishes.csv
