{
  "name": "dining-agent",
  "version": "1.0.0",
  "description": "iMessage dining agent on Photon Spectrum + Gemini",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "tsx --env-file=.env src/main.ts",
    "terminal": "MODE=terminal tsx --env-file=.env src/main.ts",
    "typecheck": "tsc",
    "send": "tsx --env-file=.env scripts/send.ts",
    "vision": "cd vision-server && uv run uvicorn server:app --host 127.0.0.1 --port 8788",
    "deploy": "./scripts/deploy-lambda.sh",
    "sim": "tsx --env-file=.env chat-sim.mts",
    "start:free": "tsx --env-file=.env.free src/main.ts",
    "start:render": "tsx src/main.ts"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-lambda": "^3.1149.0",
    "@aws-sdk/client-polly": "^3.1149.0",
    "@aws-sdk/client-rds-data": "^3.1149.0",
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1149.0",
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@photon-ai/advanced-imessage": "^2.2.0",
    "heif2jpeg": "^0.1.6",
    "sharp": "^0.35.5",
    "spectrum-ts": "^12.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.6"
  },
  "private": true
}
