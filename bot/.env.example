# Copy to .env. Never commit .env.
# AWS credentials come from `aws login` (default profile). Photon credentials load from AWS Secrets Manager
# (secret "photon/project-secret": {"projectId","projectSecret","webhookSecret"}), not from here.

AWS_REGION=us-east-2

# Claude on Bedrock (an inference profile your account can use).
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# From the dining-vector-db CloudFormation stack outputs (../infra/vector-db.yaml).
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=dining

# Optional
# MODE=terminal                     # local chat UI instead of iMessage
# SAM_URL=http://127.0.0.1:8788     # SAM 2 server (npm run vision): food photos come back outlined
# POLLY_VOICE_ID=Joanna             # us-east-2 only has Polly "standard" voices
# ELEVENLABS_API_KEY=               # optional nicer voice; AWS Polly/Transcribe are used when unset
# BOT_TIMEZONE=America/New_York     # when "today" rolls over for calorie tracking
# BOT_NAMES=bot,food bot,dining agent   # what the bot answers to in group chats (comma-separated)
# PLAN_NUDGE_MIN=10                 # "schedule dinner with…": nudge someone who hasn't answered after this long
# PLAN_GIVE_UP_MIN=40               # ...and move on without them after this long
