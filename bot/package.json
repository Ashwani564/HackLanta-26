{
  "name": "dining-agent",
  "version": "1.0.0",
  "description": "iMessage dining agent on Photon Spectrum + Gemini",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "terminal": "MODE=terminal tsx --env-file=.env src/index.ts",
    "typecheck": "tsc",
    "send": "tsx --env-file=.env scripts/send.ts",
    "vision": "cd vision-server && uv run uvicorn server:app --host 127.0.0.1 --port 8788"
  },
  "type": "module",
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@google/genai": "^2.28.0",
    "@photon-ai/advanced-imessage": "^2.2.0",
    "sharp": "^0.35.5",
    "spectrum-ts": "^12.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.6"
  },
  "private": true
}
