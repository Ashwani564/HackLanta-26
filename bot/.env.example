# Copy to .env and fill in. Never commit .env.

# Photon project credentials: https://app.photon.codes -> project -> Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ElevenLabs: https://elevenlabs.io -> Settings -> API Keys
# Optional. When set, ElevenLabs handles STT (Scribe) + TTS; without it, Gemini does both.
ELEVENLABS_API_KEY=
# Optional overrides (defaults shown). Browse voices in the ElevenLabs dashboard.
# TTS outputs MP3 (mp3_44100_128), which the free tier allows.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5   # low latency; eleven_multilingual_v2 = max quality
# ELEVENLABS_STT_MODEL=scribe_v2

# Optional. MODE: imessage | terminal. LOG_LEVEL: info | debug.
MODE=imessage
LOG_LEVEL=info
# Comma-separated fallback order:
# GEMINI_MODEL=gemini-2.5-flash,gemini-3.1-flash-lite
